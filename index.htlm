<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>KYOBI — Thu nhỏ dáng hình Việt</title>
<style>
:root{--ink:#28231f;--paper:#fbf6ed;--red:#b83d2e;--gold:#d4a94f;--muted:#786e62;--line:#e7dccb}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif}button,input{font:inherit}button{cursor:pointer}.topbar{background:var(--ink);color:#fff3dc;text-align:center;padding:9px 14px;font-size:11px;letter-spacing:.1em}.nav{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:20px clamp(18px,5vw,76px);border-bottom:1px solid var(--line);position:sticky;top:0;background:var(--paper);z-index:10}.brand{font:700 30px Georgia,serif;letter-spacing:.18em}.brand small{display:block;font:9px Inter,system-ui,sans-serif;letter-spacing:.2em;color:var(--muted);margin-top:3px}.navlinks{display:flex;gap:25px}.navlinks a{font-size:13px;color:var(--ink);text-decoration:none}.navlinks a:hover{color:var(--red)}.cartbtn,.primary{border:0;background:var(--red);color:white;padding:12px 16px;font-weight:700;border-radius:3px}.cartbtn span{background:white;color:var(--red);padding:2px 6px;border-radius:20px;margin-left:5px}.hero{display:grid;grid-template-columns:1fr 1fr;background:#efe4d2;min-height:500px}.hero-copy{padding:clamp(32px,7vw,90px);display:flex;flex-direction:column;justify-content:center;align-items:flex-start}.eyebrow{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--red);font-weight:800}.hero h1{font:500 clamp(42px,5.3vw,74px)/1.02 Georgia,serif;margin:20px 0}.hero h1 em{color:var(--red);font-weight:400}.hero p{max-width:470px;color:#62574c;line-height:1.8;font-size:15px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:18px}.secondary{background:transparent;border:1px solid #9d8d78;padding:12px 16px;color:var(--ink);border-radius:3px;font-weight:700}.hero-art{position:relative;overflow:hidden;min-height:370px;background:linear-gradient(145deg,#b94d38,#8f2e27 58%,#602a27);display:flex;align-items:center;justify-content:center}.hero-art:before{content:"";position:absolute;width:410px;height:410px;border:1px solid #e8c98b66;border-radius:50%;box-shadow:0 0 0 30px #e8c98b0c,0 0 0 70px #e8c98b0c}.hero-art:after{content:"";position:absolute;inset:24px;border:1px solid #f4d9a855}.art-card{position:relative;z-index:1;width:min(70%,360px);aspect-ratio:4/5;background:#f5e8ce;border-radius:48% 48% 8px 8px;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 24px 60px #3d181955;transform:rotate(3deg);border:7px solid #e5c88d}.art-sun{position:absolute;width:150px;height:150px;border-radius:50%;background:#d7a64c;top:14%;right:13%}.miniature{font-size:100px;z-index:1}.art-label{font:25px Georgia,serif;text-align:center;z-index:1;margin-top:14px}.art-sub{font-size:9px;letter-spacing:.2em;margin-top:8px;z-index:1}.floating-tag{position:absolute;bottom:12%;left:9%;background:#fbf3e3;padding:13px 16px;z-index:2;font:italic 15px Georgia,serif;box-shadow:0 8px 20px #321b1b33}.ticker{background:var(--red);color:#fff3dc;padding:14px;white-space:nowrap;overflow:hidden;font-size:11px;letter-spacing:.18em;text-align:center}.section{padding:72px clamp(18px,5vw,76px)}.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:28px}.section h2{font:500 clamp(32px,4vw,46px) Georgia,serif;margin:9px 0 0}.section-head p{max-width:390px;color:var(--muted);font-size:13px;line-height:1.7;margin:0}.categories{display:flex;gap:8px;flex-wrap:wrap;margin:26px 0 20px}.category{border:1px solid var(--line);background:transparent;padding:10px 16px;border-radius:30px;color:var(--muted);font-size:12px}.category.active,.category:hover{background:var(--ink);border-color:var(--ink);color:#fff3dc}.shop-tools{display:flex;gap:12px;justify-content:space-between;align-items:center;margin-bottom:22px;flex-wrap:wrap}.search{width:min(100%,320px);padding:12px 14px;background:#fffaf2;border:1px solid var(--line);outline-color:var(--gold)}.result-count{font-size:12px;color:var(--muted)}.products{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.product{border:1px solid var(--line);background:#fffaf3;min-width:0;transition:transform .2s,box-shadow .2s}.product:hover{transform:translateY(-4px);box-shadow:0 12px 28px #4b30100d}.product-art{height:245px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}.product-art:before{content:"";position:absolute;width:170px;height:170px;border-radius:50%;border:1px solid #00000010}.product-art .emoji{font-size:82px;filter:drop-shadow(0 10px 3px #35261a20);z-index:1}.badge{position:absolute;top:14px;left:14px;background:#fff8e9;padding:7px 9px;font-size:9px;letter-spacing:.1em;text-transform:uppercase;z-index:2}.product-info{padding:18px}.series-label{color:var(--red);font-size:10px;letter-spacing:.12em;text-transform:uppercase;font-weight:800}.product h3{font:500 23px Georgia,serif;margin:8px 0}.product-desc{font-size:12px;line-height:1.65;color:var(--muted);min-height:40px}.product-bottom{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:18px}.price{font-weight:800;font-size:14px}.add{border:1px solid var(--ink);background:transparent;padding:9px 12px;font-size:11px;font-weight:800}.add:hover{background:var(--ink);color:white}.how{background:#eae0cf}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:35px}.step{border-top:1px solid #c7b8a2;padding-top:18px}.step-num{font:italic 28px Georgia,serif;color:var(--red)}.step h3{font:500 22px Georgia,serif;margin:12px 0 8px}.step p{font-size:13px;color:var(--muted);line-height:1.8}.feature{display:grid;grid-template-columns:.9fr 1.1fr;gap:44px;align-items:center}.feature-visual{min-height:330px;background:#d4d9c7;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}.feature-visual:before{content:"";width:250px;height:250px;border:1px solid #50694c66;border-radius:50%;position:absolute}.feature-visual .emoji{font-size:110px;z-index:1}.feature-copy p{color:var(--muted);line-height:1.8;font-size:14px}.feature-list{list-style:none;padding:0;margin:24px 0}.feature-list li{padding:12px 0;border-bottom:1px solid var(--line);font-size:13px}.feature-list li:before{content:"✳";color:var(--red);margin-right:12px}.newsletter{background:var(--ink);color:#fff3dc;padding:54px clamp(18px,5vw,76px);display:flex;align-items:center;justify-content:space-between;gap:28px;flex-wrap:wrap}.newsletter h2{font:500 34px Georgia,serif;margin:8px 0}.newsletter p{color:#c9bba7;font-size:13px;line-height:1.7;max-width:420px}.emailform{display:flex;gap:8px;max-width:420px;width:100%}.emailform input{min-width:0;flex:1;padding:13px;border:1px solid #655a4d;background:#352f29;color:white}.emailform button{background:var(--gold);color:var(--ink);border:0;padding:13px 17px;font-weight:800}footer{padding:28px clamp(18px,5vw,76px);display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;font-size:11px;color:var(--muted)}.footer-brand{font:20px Georgia,serif;letter-spacing:.2em;color:var(--ink)}.cart-panel{position:fixed;right:0;top:0;height:100dvh;width:min(420px,100%);background:#fffaf3;z-index:30;box-shadow:-15px 0 50px #0002;padding:24px;transform:translateX(110%);transition:transform .25s;display:flex;flex-direction:column}.cart-panel.open{transform:translateX(0)}.cart-head{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:15px}.cart-head h2{font:500 28px Georgia,serif;margin:0}.close{border:0;background:transparent;font-size:25px}.cart-items{overflow:auto;flex:1}.cart-item{display:flex;gap:12px;padding:16px 0;border-bottom:1px solid var(--line)}.cart-emoji{font-size:34px;background:#efe4d2;width:58px;height:58px;display:grid;place-items:center}.cart-item-info{flex:1}.cart-item-info strong{display:block;font:500 17px Georgia,serif}.cart-item-info small{color:var(--muted)}.qty{display:flex;align-items:center;gap:9px;margin-top:8px}.qty button{border:1px solid var(--line);background:transparent;width:25px;height:25px}.cart-foot{border-top:1px solid var(--line);padding-top:18px}.total{display:flex;justify-content:space-between;font-weight:800;margin-bottom:14px}.checkout{width:100%;padding:14px;border:0;background:var(--red);color:white;font-weight:800}.empty{color:var(--muted);font-size:13px;line-height:1.7;text-align:center;padding:40px 10px}.overlay{position:fixed;inset:0;background:#211a16a1;z-index:25;display:none}.overlay.show{display:block}.toast{position:fixed;bottom:24px;left:50%;transform:translate(-50%,20px);background:var(--ink);color:white;padding:13px 20px;font-size:12px;z-index:50;opacity:0;pointer-events:none;transition:.2s}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:850px){.navlinks{gap:12px}.navlinks a{display:none}.hero{grid-template-columns:1fr}.hero-art{min-height:350px}.products{grid-template-columns:repeat(2,minmax(0,1fr))}.feature{grid-template-columns:1fr}.section-head{align-items:flex-start;flex-direction:column}}
@media(max-width:520px){.nav{padding:16px}.brand{font-size:25px}.hero-copy{padding:35px 22px}.hero-art{min-height:315px}.products{grid-template-columns:1fr}.product-art{height:245px}.steps{grid-template-columns:1fr}.section{padding:52px 18px}.newsletter{padding:42px 18px}.emailform{flex-direction:column}.emailform button{width:100%}.floating-tag{font-size:12px}}
</style>
</head>
<body>
<div class="topbar">MIỄN PHÍ VẬN CHUYỂN CHO ĐƠN TỪ 499.000₫ · SƯU TẦM VĂN HÓA VIỆT THEO CÁCH CỦA BẠN</div>
<header class="nav">
<a href="#" style="text-decoration:none;color:inherit"><div class="brand">KYOBI<small>VIETNAMESE CULTURE MINIATURE</small></div></a>
<nav class="navlinks"><a href="#shop">Cửa hàng</a><a href="#series">Các series</a><a href="#collect">Cách sưu tầm</a><a href="#story">Câu chuyện</a></nav>
<button class="cartbtn" id="openCart">Giỏ hàng <span id="cartCount">0</span></button>
</header>
<main>
<section class="hero"><div class="hero-copy"><div class="eyebrow">A little piece of Việt Nam</div><h1>Thu nhỏ dáng hình Việt, <em>lưu giữ hồn văn hóa.</em></h1><p>Mỗi chiếc hộp là một mảnh ghép văn hóa Việt Nam — từ phiên chợ Tết, đêm hội trăng rằm đến những di sản và làng nghề thân thuộc. Sưu tập từng hộp, ghép thành một câu chuyện trọn vẹn.</p><div class="hero-actions"><a href="#shop"><button class="primary">Khám phá bộ sưu tập ↗</button></a><a href="#collect"><button class="secondary">Cách chơi KYOBI</button></a></div></div><div class="hero-art"><div class="art-sun"></div><div class="art-card"><div class="miniature">🏮</div><div class="art-label">Chuyện kể<br>đất Việt</div><div class="art-sub">COLLECT · CONNECT · COMPLETE</div></div><div class="floating-tag">Mỗi hộp, một mảnh ký ức.</div></div></section>
<div class="ticker">TẾT VIỆT ✳ HỘI LÀNG ✳ DI SẢN ✳ PHỐ CỔ ✳ NGHỆ THUẬT DÂN GIAN ✳ MỖI HỘP MỘT MẢNH VĂN HÓA ✳</div>
<section class="section" id="shop"><div class="section-head"><div><div class="eyebrow">The KYOBI collection</div><h2>Mở hộp, khám phá Việt Nam.</h2></div><p>Chọn series bạn yêu thích. Mỗi hộp chứa một nhân vật hoặc chi tiết bất ngờ; sưu tập đủ các mảnh để hoàn thiện mô hình trưng bày.</p></div>
<div class="categories" id="categories"><button class="category active" data-category="Tất cả">Tất cả</button><button class="category" data-category="Tết Việt">Tết Việt</button><button class="category" data-category="Lễ hội">Lễ hội</button><button class="category" data-category="Di sản">Di sản</button><button class="category" data-category="Nghệ thuật & làng nghề">Nghệ thuật & làng nghề</button><button class="category" data-category="Phụ kiện">Phụ kiện</button></div>
<div class="shop-tools"><input class="search" id="search" placeholder="Tìm mô hình, series..." aria-label="Tìm sản phẩm"><span class="result-count" id="resultCount">8 sản phẩm</span></div><div class="products" id="products"></div></section>
<section class="section how" id="collect"><div class="section-head"><div><div class="eyebrow">Collect to complete</div><h2>Không chỉ là blind box.</h2></div><p>Một trò chơi sưu tầm kết nối những mảnh ghép nhỏ thành một mô hình lớn — để mỗi lần mở hộp đều có thêm điều để mong chờ.</p></div><div class="steps"><div class="step"><div class="step-num">01 / Mở hộp</div><h3>Đón một điều bất ngờ</h3><p>Mỗi hộp có một nhân vật hoặc chi tiết thuộc series. Thiết kế, phụ kiện và thẻ chuyện đi kèm giúp bạn khám phá nét văn hóa phía sau mô hình.</p></div><div class="step"><div class="step-num">02 / Sưu tầm</div><h3>Tìm những mảnh còn thiếu</h3><p>Các mẫu trong cùng series được thiết kế để kết nối với nhau. Đổi mẫu trùng với bạn bè và cùng nhau hoàn thiện bộ sưu tập.</p></div><div class="step"><div class="step-num">03 / Hoàn thiện</div><h3>Ghép thành một Việt Nam thu nhỏ</h3><p>Khi đủ các mảnh, bạn có thể lắp thành sân hội, con phố hay một tiểu cảnh văn hóa hoàn chỉnh để trưng bày.</p></div></div></section>
<section class="section" id="series"><div class="feature"><div class="feature-visual"><div class="emoji">🏮🏘️</div></div><div class="feature-copy"><div class="eyebrow">Designed to connect</div><h2 style="font:500 clamp(32px,4vw,46px) Georgia,serif;margin:12px 0">Mỗi series, một lát cắt văn hóa.</h2><p>KYOBI lấy cảm hứng từ phong tục, kiến trúc, lễ hội và nghề thủ công Việt Nam. Mô hình được cách điệu để đáng yêu, dễ trưng bày nhưng vẫn giữ những chi tiết nhận diện của nguyên mẫu.</p><ul class="feature-list"><li>Thẻ kể chuyện ngắn về nguồn cảm hứng văn hóa</li><li>Chi tiết kết nối để ghép thành tiểu cảnh lớn</li><li>Thiết kế sưu tầm theo series, có mẫu hiếm và mẫu bí mật</li><li>Ưu tiên thông tin văn hóa rõ ràng, tôn trọng di sản</li></ul><a href="#shop"><button class="primary">Chọn series của bạn ↗</button></a></div></div></section>
<section class="newsletter" id="story"><div><div class="eyebrow" style="color:var(--gold)">The KYOBI letter</div><h2>Chuyện Việt, gửi đến bạn.</h2><p>Đăng ký để nhận tin về series mới, các đợt mở bán và những câu chuyện văn hóa đứng sau từng mô hình.</p></div><form class="emailform" id="newsletter"><input type="email" placeholder="Email của bạn" required><button type="submit">Đăng ký ↗</button></form></section>
</main>
<footer><div><div class="footer-brand">KYOBI</div><div style="margin-top:8px">Thu nhỏ dáng hình Việt, lưu giữ hồn văn hóa.</div></div><div>© 2026 KYOBI · Bản demo cửa hàng</div><div>Instagram　 TikTok　 Liên hệ</div></footer>
<div class="overlay" id="overlay"></div><aside class="cart-panel" id="cartPanel" aria-label="Giỏ hàng"><div class="cart-head"><h2>Giỏ hàng của bạn</h2><button class="close" id="closeCart" aria-label="Đóng">×</button></div><div class="cart-items" id="cartItems"></div><div class="cart-foot"><div class="total"><span>Tạm tính</span><span id="cartTotal">0₫</span></div><button class="checkout" id="checkout">TIẾN HÀNH ĐẶT HÀNG</button><p style="font-size:10px;color:var(--muted);line-height:1.6">Đây là giao diện demo; chưa kết nối thanh toán hoặc vận chuyển thật.</p></div></aside><div class="toast" id="toast"></div>
<script>
const productsData=[
{id:1,name:"Phiên chợ đầu xuân",series:"Tết Việt",price:159000,emoji:"🌸",bg:"#f0d8c8",badge:"Series 01",desc:"Gánh hoa, câu đối đỏ và sắc xuân trong một tiểu cảnh chợ Tết.",pieces:"6 mảnh ghép"},
{id:2,name:"Đêm hội trăng rằm",series:"Lễ hội",price:159000,emoji:"🏮",bg:"#d8d8e7",badge:"Series 02",desc:"Đèn ông sao, trống hội và những ký ức Trung thu tuổi thơ.",pieces:"6 mảnh ghép"},
{id:3,name:"Sân hội làng",series:"Lễ hội",price:179000,emoji:"🐃",bg:"#e6d9bc",badge:"Series 03",desc:"Không khí hội làng với cờ hội, trống và hình tượng chọi trâu Đồ Sơn.",pieces:"6 mảnh ghép"},
{id:4,name:"Dấu xưa Hoàng cung",series:"Di sản",price:189000,emoji:"🏯",bg:"#e9d2ad",badge:"Series 04",desc:"Lấy cảm hứng từ kiến trúc và trang phục cung đình Huế.",pieces:"8 mảnh ghép"},
{id:5,name:"Phố đèn lồng Hội An",series:"Di sản",price:169000,emoji:"🏘️",bg:"#edc8a8",badge:"Series 05",desc:"Mái ngói, nhà vàng và những chiếc đèn lồng của phố cổ.",pieces:"8 mảnh ghép"},
{id:6,name:"Góc làng nghề",series:"Nghệ thuật & làng nghề",price:149000,emoji:"🏺",bg:"#d7dfd0",badge:"Series 06",desc:"Một góc nhỏ tôn vinh gốm, dệt và đôi bàn tay người thợ Việt.",pieces:"6 mảnh ghép"},
{id:7,name:"Bộ đế trưng bày",series:"Phụ kiện",price:79000,emoji:"🪵",bg:"#d8c5a9",badge:"Phụ kiện",desc:"Đế ghép mô hình, phù hợp để trưng bày bộ sưu tập hoàn chỉnh.",pieces:"Phụ kiện"},
{id:8,name:"Bộ thẻ chuyện Việt",series:"Phụ kiện",price:39000,emoji:"📜",bg:"#efe5ce",badge:"Phụ kiện",desc:"Thẻ minh họa và thông tin ngắn về nguồn cảm hứng văn hóa.",pieces:"Phụ kiện"}];
let activeCategory="Tất cả",cart={};const money=n=>n.toLocaleString("vi-VN")+"₫";const products=document.getElementById("products");
function renderProducts(){const q=document.getElementById("search").value.trim().toLocaleLowerCase("vi");const filtered=productsData.filter(p=>(activeCategory==="Tất cả"||p.series===activeCategory)&&(p.name+" "+p.series+" "+p.desc).toLocaleLowerCase("vi").includes(q));document.getElementById("resultCount").textContent=filtered.length+" sản phẩm";products.innerHTML=filtered.length?filtered.map(p=>`<article class="product"><div class="product-art" style="background:${p.bg}"><span class="badge">${p.badge}</span><span class="emoji">${p.emoji}</span></div><div class="product-info"><div class="series-label">${p.series}</div><h3>${p.name}</h3><p class="product-desc">${p.desc}</p><div class="product-bottom"><div><div class="price">${money(p.price)}</div><div style="font-size:10px;color:#8b7d6c;margin-top:5px">${p.pieces}</div></div><button class="add" onclick="addToCart(${p.id})">THÊM +</button></div></div></article>`).join(""):'<p style="color:var(--muted);grid-column:1/-1;padding:30px 0">Không tìm thấy sản phẩm phù hợp. Thử từ khóa khác nhé.</p>'}
document.getElementById("categories").addEventListener("click",e=>{const b=e.target.closest("button[data-category]");if(!b)return;activeCategory=b.dataset.category;document.querySelectorAll(".category").forEach(x=>x.classList.toggle("active",x===b));renderProducts()});document.getElementById("search").addEventListener("input",renderProducts);
function addToCart(id){cart[id]=(cart[id]||0)+1;renderCart();showToast("Đã thêm vào giỏ hàng")}function changeQty(id,delta){cart[id]=(cart[id]||0)+delta;if(cart[id]<=0)delete cart[id];renderCart()}
function renderCart(){const entries=Object.entries(cart),count=entries.reduce((s,[,n])=>s+n,0);document.getElementById("cartCount").textContent=count;document.getElementById("cartItems").innerHTML=entries.length?entries.map(([id,n])=>{const p=productsData.find(x=>x.id===Number(id));return `<div class="cart-item"><div class="cart-emoji">${p.emoji}</div><div class="cart-item-info"><strong>${p.name}</strong><small>${money(p.price)}</small><div class="qty"><button onclick="changeQty(${p.id},-1)">−</button><span>${n}</span><button onclick="changeQty(${p.id},1)">+</button></div></div><b>${money(p.price*n)}</b></div>`}).join(""):'<div class="empty">Giỏ hàng đang trống.<br>Chọn một mảnh văn hóa bạn thích để bắt đầu sưu tầm nhé.</div>';document.getElementById("cartTotal").textContent=money(entries.reduce((s,[id,n])=>s+productsData.find(p=>p.id===Number(id)).price*n,0))}
const panel=document.getElementById("cartPanel"),overlay=document.getElementById("overlay");function openCart(){panel.classList.add("open");overlay.classList.add("show")}function closeCart(){panel.classList.remove("open");overlay.classList.remove("show")}document.getElementById("openCart").addEventListener("click",openCart);document.getElementById("closeCart").addEventListener("click",closeCart);overlay.addEventListener("click",closeCart);document.getElementById("checkout").addEventListener("click",()=>showToast(Object.keys(cart).length?"Đây là bản demo — chưa có thanh toán thật.":"Giỏ hàng của bạn đang trống."));
let toastTimer;function showToast(msg){const t=document.getElementById("toast");t.textContent=msg;t.classList.add("show");clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove("show"),2200)}document.getElementById("newsletter").addEventListener("submit",e=>{e.preventDefault();e.target.reset();showToast("Cảm ơn bạn đã đăng ký nhận tin KYOBI!")});renderProducts();renderCart();
</script>
</body>
</html>
